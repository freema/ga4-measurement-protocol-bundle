{
    "name": "freema/ga4-measurement-protocol-bundle",
    "description": "Google Analytics 4 Measurement Protocol Bundle for Symfony applications",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Freema",
            "homepage": "https://github.com/freema"
        }
    ],
    "require": {
        "php": ">=8.1",
        "symfony/http-kernel": "^5.4|^6.4|^7.1|^8.0",
        "symfony/framework-bundle": "^5.4|^6.4|^7.1|^8.0",
        "symfony/dependency-injection": "^5.4|^6.4|^7.1|^8.0",
        "symfony/config": "^5.4|^6.4|^7.1|^8.0",
        "symfony/http-client": "^5.4|^6.4|^7.1|^8.0",
        "symfony/yaml": "^5.4|^6.4|^7.1|^8.0",
        "psr/http-client": "^1.0",
        "php-http/discovery": "^1.14",
        "symfony/http-client-contracts": "^2.5|^3.0",
        "nyholm/psr7": "^1.5"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.14",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "symfony/debug-bundle": "^5.4|^6.4|^7.1|^8.0",
        "symfony/monolog-bundle": "^3.8|^4.0",
        "symfony/web-profiler-bundle": "^5.4|^6.4|^7.1|^8.0",
        "symfony/routing": "^5.4|^6.4|^7.1|^8.0",
        "doctrine/annotations": "^1.13|^2.0"
    },
    "autoload": {
        "psr-4": {
            "Freema\\GA4MeasurementProtocolBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Freema\\GA4MeasurementProtocolBundle\\Tests\\": "tests/",
            "Freema\\GA4MeasurementProtocolBundle\\Dev\\": "dev/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "phpstan": "phpstan analyse src"
    },
    "minimum-stability": "stable"
}
